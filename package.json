{
  "name": "negaresh-design-system",
  "private": true,
  "type": "module",
  "description": "Negaresh Design System (NDS) — دیزاین سیستم نگرش",
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "turbo run dev --filter=@negaresh/docs",
    "build": "turbo run build",
    "tokens": "turbo run build --filter=@negaresh/tokens",
    "tokens:check": "turbo run check --filter=@negaresh/tokens",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e --filter=@negaresh/docs",
    "lint": "biome lint . && stylelint \"**/*.css\"",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@changesets/cli": "3.0.3",
    "@types/node": "22.20.5",
    "stylelint": "18.0.0",
    "turbo": "2.11.11",
    "typescript": "6.0.3"
  }
}
