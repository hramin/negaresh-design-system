{
  "name": "@negaresh/charts",
  "version": "0.0.0",
  "private": true,
  "description": "NDS SSR-capable SVG charts on d3-scale and d3-shape, styled with CSS Modules in cascade layers.",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "@negaresh/source": "./src/index.ts",
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./messages/fa": {
      "@negaresh/source": "./src/messages/fa.ts",
      "types": "./dist/types/messages/fa.d.ts",
      "default": "./dist/messages/fa.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint ."
  },
  "dependencies": {
    "@negaresh/icons": "workspace:*",
    "@negaresh/react": "workspace:*",
    "@negaresh/tokens": "workspace:*",
    "@negaresh/utils": "workspace:*",
    "d3-scale": "4.0.3",
    "d3-shape": "3.2.1"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/d3-scale": "4.0.9",
    "@types/d3-shape": "3.2.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "axe-core": "4.14.0",
    "jsdom": "31.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
