{
  "name": "@negaresh/utils",
  "version": "0.0.0",
  "private": true,
  "description": "Display and input formatting for Persian products: Jalali dates (Asia/Tehran), Persian digits, Toman, phones, serials.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@negaresh/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint ."
  },
  "dependencies": {
    "@internationalized/date": "3.12.4"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.1.0",
    "vitest": "5.1.0"
  }
}
