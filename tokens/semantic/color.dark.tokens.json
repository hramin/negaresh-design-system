{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Company theme \u2014 dark mode. Aliases only; no raw values except dark status backgrounds.",
  "color": {
    "$type": "color",
    "bg": {
      "canvas": {
        "$value": "{color.ink.950}"
      },
      "surface": {
        "$value": "{color.ink.900}"
      },
      "sunken": {
        "$value": "{color.ink.1000}"
      },
      "hover": {
        "$value": "{color.ink.850}"
      },
      "selected": {
        "$value": "{color.teal.950}"
      },
      "inverse": {
        "$value": "{color.ink.100}"
      }
    },
    "fg": {
      "default": {
        "$value": "{color.ink.100}"
      },
      "muted": {
        "$value": "{color.ink.200}"
      },
      "subtle": {
        "$value": "{color.ink.300}"
      },
      "disabled": {
        "$value": "{color.ink.500}"
      },
      "inverse": {
        "$value": "{color.ink.950}"
      }
    },
    "border": {
      "default": {
        "$value": "{color.ink.800}"
      },
      "strong": {
        "$value": "{color.ink.700}"
      },
      "control": {
        "$value": "{color.ink.500}"
      }
    },
    "accent": {
      "default": {
        "$value": "{color.teal.400}"
      },
      "hover": {
        "$value": "{color.teal.300}"
      },
      "pressed": {
        "$value": "{color.teal.200}"
      },
      "subtle": {
        "$value": "{color.teal.950}"
      },
      "fg": {
        "$value": "{color.teal.300}"
      },
      "on": {
        "$value": "{color.ink.1000}"
      }
    },
    "focus": {
      "ring": {
        "$value": "{color.teal.300}"
      }
    },
    "success": {
      "fg": {
        "$value": "{color.sage.300}"
      },
      "bg": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.0863,
            0.1373,
            0.1059
          ],
          "hex": "#16231B"
        }
      },
      "border": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.1686,
            0.2588,
            0.1961
          ],
          "hex": "#2B4232"
        }
      }
    },
    "warning": {
      "fg": {
        "$value": "{color.ochre.300}"
      },
      "bg": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.149,
            0.1294,
            0.0824
          ],
          "hex": "#262115"
        }
      },
      "border": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.2706,
            0.2235,
            0.1216
          ],
          "hex": "#45391F"
        }
      }
    },
    "danger": {
      "fg": {
        "$value": "{color.rose.300}"
      },
      "bg": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.1647,
            0.098,
            0.102
          ],
          "hex": "#2A191A"
        }
      },
      "border": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.3059,
            0.1725,
            0.1686
          ],
          "hex": "#4E2C2B"
        }
      }
    },
    "info": {
      "fg": {
        "$value": "{color.slate.300}"
      },
      "bg": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.0863,
            0.1255,
            0.1647
          ],
          "hex": "#16202A"
        }
      },
      "border": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.1647,
            0.2314,
            0.302
          ],
          "hex": "#2A3B4D"
        }
      }
    },
    "viz": {
      "1": {
        "$value": "{color.teal.300}"
      },
      "2": {
        "$value": "{color.ochre.300}"
      },
      "3": {
        "$value": "{color.slate.300}"
      },
      "4": {
        "$value": "{color.clay.300}"
      },
      "5": {
        "$value": "{color.mauve.300}"
      },
      "6": {
        "$value": "{color.sage.300}"
      },
      "ref": {
        "$value": "{color.ink.400}"
      },
      "band": {
        "$value": "{color.ink.800}"
      },
      "grid": {
        "$value": "{color.ink.800}"
      }
    }
  }
}