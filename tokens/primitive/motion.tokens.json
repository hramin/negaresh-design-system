{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "duration": {
    "$type": "duration",
    "instant": {
      "$value": {
        "value": 80,
        "unit": "ms"
      }
    },
    "fast": {
      "$value": {
        "value": 120,
        "unit": "ms"
      }
    },
    "base": {
      "$value": {
        "value": 200,
        "unit": "ms"
      }
    },
    "slow": {
      "$value": {
        "value": 320,
        "unit": "ms"
      }
    }
  },
  "easing": {
    "$type": "cubicBezier",
    "standard": {
      "$value": [
        0.2,
        0.7,
        0.2,
        1
      ]
    },
    "enter": {
      "$value": [
        0,
        0,
        0.2,
        1
      ]
    },
    "exit": {
      "$value": [
        0.4,
        0,
        1,
        1
      ]
    }
  }
}