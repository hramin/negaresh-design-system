{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "size": {
    "$type": "dimension",
    "control": {
      "sm": {
        "$value": {
          "value": 40,
          "unit": "px"
        }
      },
      "md": {
        "$value": {
          "value": 48,
          "unit": "px"
        }
      },
      "lg": {
        "$value": {
          "value": 56,
          "unit": "px"
        }
      }
    },
    "touch": {
      "$value": {
        "value": 44,
        "unit": "px"
      },
      "$description": "Minimum target for every interactive element (WCAG 2.5.8 + PRD)."
    },
    "icon": {
      "sm": {
        "$value": {
          "value": 16,
          "unit": "px"
        }
      },
      "md": {
        "$value": {
          "value": 20,
          "unit": "px"
        }
      },
      "lg": {
        "$value": {
          "value": 24,
          "unit": "px"
        }
      },
      "stroke": {
        "$type": "number",
        "$value": 1.6,
        "$description": "Icon stroke width in px on the 24 grid (docs/foundations/motion-icons.md)."
      }
    },
    "topbar": {
      "$value": {
        "value": 64,
        "unit": "px"
      }
    },
    "sidenav": {
      "$value": {
        "value": 248,
        "unit": "px"
      }
    },
    "content": {
      "narrow": {
        "$value": {
          "value": 640,
          "unit": "px"
        }
      },
      "default": {
        "$value": {
          "value": 1200,
          "unit": "px"
        }
      },
      "wide": {
        "$value": {
          "value": 1440,
          "unit": "px"
        }
      }
    },
    "measure": {
      "$value": {
        "value": 68,
        "unit": "rem"
      },
      "$description": "Not used directly; reading width is set in ch by components (66ch)."
    }
  },
  "breakpoint": {
    "$type": "dimension",
    "sm": {
      "$value": {
        "value": 600,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 900,
        "unit": "px"
      },
      "$description": "Below 900: mobile composition (inherits v3 899px)."
    },
    "lg": {
      "$value": {
        "value": 1200,
        "unit": "px"
      }
    },
    "xl": {
      "$value": {
        "value": 1440,
        "unit": "px"
      }
    }
  }
}
