{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "radius": {
    "$type": "dimension",
    "none": {
      "$value": {
        "value": 0,
        "unit": "px"
      }
    },
    "sm": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 12,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "xl": {
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "pill": {
      "$value": {
        "value": 999,
        "unit": "px"
      }
    }
  },
  "border": {
    "$type": "dimension",
    "hairline": {
      "$value": {
        "value": 1,
        "unit": "px"
      }
    },
    "thick": {
      "$value": {
        "value": 2,
        "unit": "px"
      }
    }
  },
  "shadow": {
    "$type": "shadow",
    "overlay": {
      "$value": {
        "color": {
          "colorSpace": "srgb",
          "components": [
            0.1,
            0.08,
            0.06
          ],
          "alpha": 0.18,
          "hex": "#1A1410"
        },
        "offsetX": {
          "value": 0,
          "unit": "px"
        },
        "offsetY": {
          "value": 12,
          "unit": "px"
        },
        "blur": {
          "value": 40,
          "unit": "px"
        },
        "spread": {
          "value": -8,
          "unit": "px"
        }
      },
      "$description": "Only for floating layers (popover, menu, dialog, toast). Resting surfaces never cast shadows (D-77)."
    }
  }
}