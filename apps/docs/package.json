{
  "name": "@negaresh/docs",
  "version": "0.0.0",
  "private": true,
  "description": "The NDS site: documentation, playground and visual-test target (D-87).",
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "start": "srvx --prod --port 3000 -s ../client dist/server/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "test:e2e": "playwright test --trace off",
    "test:visual": "NDS_VISUAL=1 playwright test e2e/visual.spec.ts --trace off"
  },
  "dependencies": {
    "@negaresh/charts": "workspace:*",
    "@negaresh/icons": "workspace:*",
    "@negaresh/react": "workspace:*",
    "@negaresh/theme-company": "workspace:*",
    "@negaresh/tokens": "workspace:*",
    "@negaresh/utils": "workspace:*",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.5",
    "react": "19.3.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "pixelmatch": "8.0.0",
    "pngjs": "7.0.0",
    "srvx": "1.0.8",
    "vite": "8.3.8"
  }
}
