{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/dist-theme",
      "!**/dist_keycloak",
      "!**/build_keycloak",
      "!**/.output",
      "!**/node_modules",
      "!**/coverage",
      "!reference",
      "!**/routeTree.gen.ts",
      "!**/kc.gen.tsx",
      "!**/keycloakify-dev-resources",
      "!**/*.css",
      "!**/*.md",
      "!tokens",
      "!**/screenshots"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error"
      },
      "style": {
        "noNonNullAssertion": "off"
      }
    }
  }
}
